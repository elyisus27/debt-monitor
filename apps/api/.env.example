DATABASE_URL="file:./dev.db"
PORT=9100

ISAPI_HOST=
ISAPI_PORT=80
ISAPI_USER=
ISAPI_PASS=

PLATE_SERVICE_URL=http://127.0.0.1:9300/read-plate

# Conexión con Vistara (SyncVistaraService) -- Device kind=DELINQUENT_KEYPAD, la key
# se entrega una sola vez al crearlo (pnpm create:device en el repo de Vistara).
# Sin estas 3, la sincronización queda desactivada (solo loguea un warning).
VISTARA_API_BASE_URL=https://vistara-api.condominioreserva.com
VISTARA_TENANT_SLUG=la-reserva
VISTARA_DEVICE_KEY=


PUSH_PORT=8787
PUSH_TOKEN=	abc123
POLL_SECONDS= 20

# Acceso a Morosos -- pluma del carril de morosos. Cuando Vistara autoriza una entrada
# (Tenant.delinquentKeypadOpensBarrier prendido), debt-api espera el castigo y pulsa el
# tótem directo por la LAN. Mismos valores que en apps/barrier-gateway/.env.
TOTEM_GPIO_URL=http://192.168.196.1:3001/devices/gpio/192.168.100.5:5555
TOTEM_GPIO_TOKEN=

# Bitácora de contingencia (/contingencia en apps/web) -- para cuando se cae el internet.
# Guardias: un solo usuario cuya clave de 6 dígitos cambia sola cada semana (lunes
# 00:00, hora de esta PC), derivada de CONTINGENCIA_MASTER_KEY. La lista de claves la
# genera `pnpm claves` (con la MISMA master key) y la guarda el dueño en su Drive.
# Vacío = usuario de guardias desactivado. Cambiar la master key invalida la lista.
CONTINGENCIA_WEEKLY_USER=caseta
CONTINGENCIA_MASTER_KEY=
# Dueño/administrador: "usuario:clave" separados por coma, clave fija que no vence.
CONTINGENCIA_USERS=
# Firma de las sesiones. Vacío = se genera una al arrancar (reiniciar cierra sesiones).
CONTINGENCIA_SECRET=
# Cada cuántas horas se baja el directorio de domicilios/residentes de Vistara.
DIRECTORY_REFRESH_HOURS=24
