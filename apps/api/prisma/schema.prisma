// Schema formal de access_events (Fase 2-4). Mapeado 1:1 sobre la tabla que ya
// existía en tools/httphosts-probe/data/events.db (@map conserva los nombres de
// columna originales) + 2 columnas nuevas para el handoff de diseño "Monitor de
// Cruces" (vehicle_label = "tipo" del contrato, plate_manual = "manual"). NO se
// agrega "color" -- no hay capacidad de detectarlo, no se inventa el campo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AccessEvent {
  id              Int      @id @default(autoincrement())
  ipAddress       String   @map("ip_address")
  serialNo        Int?     @map("serial_no")
  casaUnidad      String   @map("casa_unidad")
  employeeNo      String   @map("employee_no")
  timestamp       String
  puerta          String
  deviceName      String?  @map("device_name")
  verifyMode      String?  @map("verify_mode")
  subEventType    Int?     @map("sub_event_type")
  doorNo          Int?     @map("door_no")
  cardReaderNo    Int?     @map("card_reader_no")
  rawPayload      String?  @map("raw_payload")
  receivedAt      String   @map("received_at")
  photoPaths      String?  @map("photo_paths") // JSON string, ver AccessEvent.photos() en el service
  plateText       String?  @map("plate_text")
  plateConfidence Float?   @map("plate_confidence") // 0-1 (nuestra escala interna; la API la expone *100)
  plateReason     String?  @map("plate_reason")
  vehicleLabel    String?  @map("vehicle_label") // "tipo" del contrato de diseño (car/truck/bus/motorcycle)
  plateManual     Boolean  @default(false) @map("plate_manual") // "manual" del contrato -- true tras un PATCH

  // Conexión con Vistara (2026-09) -- cola durable de entrega, no fire-and-forget.
  // 'pending' = por mandar; 'sent' = Vistara lo confirmó (o respondió 'duplicate',
  // mismo trato -- ya está allá); 'error' = falló, se reintenta con backoff;
  // 'skipped' = puerta='salida' o eventos previos a esta feature, nunca se manda
  // (Vistara solo acepta direction='IN'). Ver SyncVistaraService.
  vistaraStatus   String   @default("pending") @map("vistara_status")
  vistaraAttempts Int      @default(0) @map("vistara_attempts")
  vistaraError    String?  @map("vistara_error")
  vistaraSentAt   String?  @map("vistara_sent_at")
  vistaraNextTry  String?  @map("vistara_next_try") // backoff -- no reintentar antes de esta fecha

  @@unique([ipAddress, serialNo])
  @@index([casaUnidad])
  @@index([timestamp])
  @@index([vistaraStatus])
  @@map("access_events")
}

// Fotos de registros de guardia hechos en Vistara (carril de visitantes) --
// APARTADO SEPARADO de access_events a propósito: no es un cruce de teclado
// (esos siguen viviendo solos arriba) ni un evento de LPR en caliente (ese no
// tiene certeza de cuál es "el" cruce) -- es la confirmación de un registro que
// el guardia YA guardó en Vistara. Una fila por Visit de Vistara (visitId es su
// cuid, no uno nuestro). Mismo patrón vistara* de cola durable que access_events
// -- ver GuardPhotosSyncService.
model GuardVisitPhoto {
  id         Int      @id @default(autoincrement())
  visitId    String   @unique @map("visit_id")
  tenantId   String   @map("tenant_id")
  plate      String?
  photoPaths String?  @map("photo_paths") // JSON string, relativo a data/guard-photos/
  capturedAt String?  @map("captured_at")
  createdAt  String   @map("created_at")

  // 'pending' = falta mandar a Vistara; 'sent' = confirmado; 'error' = falla,
  // reintenta con backoff; 'skipped' = captura sin fotos (GUARD_PHOTO_CHANNELS
  // vacío, o el DVR falló las 3 veces) -- nada que mandar, no se reintenta.
  vistaraStatus   String  @default("pending") @map("vistara_status")
  vistaraAttempts Int     @default(0) @map("vistara_attempts")
  vistaraError    String? @map("vistara_error")
  vistaraSentAt   String? @map("vistara_sent_at")
  vistaraNextTry  String? @map("vistara_next_try")

  @@index([vistaraStatus])
  @@map("guard_visit_photos")
}
