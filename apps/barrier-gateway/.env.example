# barrier-gateway -- servicio aislado de apertura de pluma vía túnel Cloudflare
# Copiar a .env y rellenar. El .env real NO se comitea (.gitignore).

# Puerto local. Solo cloudflared le pega -- bind a loopback, nunca 0.0.0.0.
PORT=9400
BIND_HOST=127.0.0.1

# Secreto compartido con la Vistara API. La request a POST /abrir debe traer
# el header  X-Barrier-Secret: <este valor>  o se rechaza con 401.
# Es la segunda capa: la primera es el service token de Cloudflare Access.
# Generar con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BARRIER_SHARED_SECRET=

# Endpoint GPIO del tótem CondoVive en la LAN (el mismo que usa
# lpr-caseta/src/totem_gpio.py). El segmento final es la clave adb_device
# de la tabla dev_device del tótem, no una IP:puerto real.
TOTEM_GPIO_URL=http://192.168.196.1:3001/devices/gpio/192.168.100.5:5555
# Opcional -- solo si el tótem algún día agrega auth. Vacío = no se manda header.
TOTEM_GPIO_TOKEN=
TOTEM_TIMEOUT_MS=5000

# Anti-rebote: ignora una segunda apertura dentro de esta ventana (ms).
BARRIER_MIN_INTERVAL_MS=4000
