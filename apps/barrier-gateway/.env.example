# barrier-gateway -- recibe el push de Vistara (túnel) y pulsa la pluma; relaya fotos
# Copiar a .env y rellenar. El .env real NO se comitea (.gitignore).

# --- Push (único camino, obligatorio) ------------------------------------------
# Vistara le pega directo a esto vía un túnel Cloudflare que corre aparte en esta
# misma PC (cloudflared) -- este proceso solo escucha en 127.0.0.1, nunca en la
# LAN. El poll de respaldo a Vistara se eliminó el 2026-10-02.
PUSH_PORT=8787
# Token compartido con Vistara (BARRIER_PUSH_TOKEN en su .env / Secret Manager).
# Cualquier cadena larga y aleatoria sirve -- rotarlo en ambos lados si se filtra.
PUSH_TOKEN=

# apps/api en esta misma PC (LAN-local, nunca sale de 127.0.0.1) -- usado por
# las rutas de fotos (/capture-photos, /photo/:kind/:file, ver README § Fotos).
API_BASE_URL=http://127.0.0.1:9100

# Endpoint GPIO del tótem CondoVive en la LAN (el mismo que usa
# lpr-caseta/src/totem_gpio.py). El segmento final es la clave adb_device
# de la tabla dev_device del tótem, no una IP:puerto real.
TOTEM_GPIO_URL=http://192.168.196.1:3001/devices/gpio/192.168.100.5:5555
# Opcional -- solo si el tótem algún día agrega auth. Vacío = no se manda header.
TOTEM_GPIO_TOKEN=
TOTEM_TIMEOUT_MS=5000

# Anti-rebote: ignora una segunda apertura dentro de esta ventana (ms).
BARRIER_MIN_INTERVAL_MS=4000
