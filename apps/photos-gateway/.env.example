# photos-gateway -- único punto de entrada desde internet para fotos de visitas
# Copiar a .env y rellenar. El .env real NO se comitea (.gitignore).

# apps/api en esta misma PC (LAN-local, nunca sale de 127.0.0.1). Sin barra final.
API_BASE_URL=http://127.0.0.1:9100

# Puerto local (127.0.0.1) donde escucha este proceso -- distinto del de
# barrier-gateway (8787), a propósito: apartados separados.
PUSH_PORT=8788

# Token compartido con Vistara (PHOTO_TUNNEL_TOKEN en su .env / Secret Manager),
# una sola cadena para las dos rutas (/capture y /photo/*). Vacío = el proceso
# entero no hace nada (log de "desactivado" y ya).
PHOTOS_TOKEN=
