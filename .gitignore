# dependencias / build
node_modules/
dist/
.next/
.turbo/

# credenciales / entorno local — nunca comitear
.env
.env.*
!.env.example
*.local
secrets*

# capturas de eventos reales (pueden contener datos de residentes/vehículos)
tools/**/captures/
apps/**/captures/

# DB local con eventos parseados (mismo motivo: datos reales de residentes)
tools/**/data/
apps/**/data/
*.db
*.db-journal

# clips de video del DVR (autos/placas reales de residentes)
tools/**/clips/
apps/**/clips/

# logs
*.log

# mkdocs build output
developersDocs/site/

# modelo YOLO auto-descargado por ultralytics (tools/plate-reader) -- no versionar,
# se re-descarga solo la primera vez que corre el servicio
tools/plate-reader/yolov8n.pt

# Python
__pycache__/
*.pyc
